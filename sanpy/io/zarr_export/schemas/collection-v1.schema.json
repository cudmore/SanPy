{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "created_at", "members"],
  "properties": {
    "format": {"const": "sanpy-zarr"},
    "version": {"const": "1.0-draft"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "created_at": {"type": "string"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "recording", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "recording": {"type": "string"},
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sweeps", "channels", "points", "analysis_results"],
            "properties": {
              "sweeps": {"type": "integer", "minimum": 1},
              "channels": {"type": "integer", "minimum": 1},
              "points": {"type": "integer", "minimum": 1},
              "analysis_results": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}

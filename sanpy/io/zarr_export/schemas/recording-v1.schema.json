{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "unit"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "unit": {"type": "string"},
        "values_are_scaled": {"const": true}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "representations"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "representations": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "csv": {"type": "string", "pattern": "^[^/\\\\]+\\.csv$"},
            "parquet": {"type": "string", "pattern": "^[^/\\\\]+\\.parquet$"}
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "dimensions", "sampling_rate_hz", "protocol", "acquisition_datetime", "channels", "command_channels", "analysis_channel", "source", "export", "resources"],
  "properties": {
    "format": {"const": "sanpy-zarr-recording"},
    "version": {"const": "1.0-draft"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sweeps", "channels", "points"],
      "properties": {
        "sweeps": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1},
        "points": {"type": "integer", "minimum": 1}
      }
    },
    "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "protocol": {"type": "string"},
    "acquisition_datetime": {"type": "string"},
    "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel"}},
    "command_channels": {"type": "array", "items": {"$ref": "#/$defs/channel"}},
    "analysis_channel": {"type": "integer", "minimum": 0},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "format", "reader_version"],
      "properties": {
        "filename": {"type": "string"},
        "format": {"enum": ["abf", "sanpy"]},
        "reader_version": {"type": "string"}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sanpy_version"],
      "properties": {"sanpy_version": {"type": "string"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "epochs", "analysis_results", "sanpy_metadata", "detection_parameters", "detection_parameter_definitions", "analysis_result_definitions", "trace_overlays"],
      "properties": {
        "data": {"const": "data.zarr"},
        "epochs": {"$ref": "#/$defs/table"},
        "analysis_results": {"$ref": "#/$defs/table"},
        "sanpy_metadata": {"const": "metadata/sanpy_metadata.json"},
        "detection_parameters": {"const": "metadata/detection_parameters.json"},
        "detection_parameter_definitions": {"const": "metadata/detection_parameter_definitions.json"},
        "analysis_result_definitions": {"const": "metadata/analysis_result_definitions.json"},
        "trace_overlays": {"const": "metadata/trace_overlays.json"}
      }
    }
  }
}

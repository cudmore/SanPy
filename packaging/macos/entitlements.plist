<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for PyInstaller bootloaders under Hardened Runtime.
	     https://github.com/pyinstaller/pyinstaller/issues/4629 -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Nested .dylib/.so signed with the same Developer ID still fail
	     library validation in some PyInstaller layouts. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
